// About
Route::get('/about', [SiteController::class, 'about'])->name('about');

// Contact
Route::get('/contact', [SiteController::class, 'contact'])->name('contact');

Route::get('/bpr', [SiteController::class, 'bpr_landing'])->name('bpr_landing');

